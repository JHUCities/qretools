{
	"name": "@qretools/cli",
	"version": "2.0.0-alpha.0",
	"private": true,
	"type": "module",
	"description": "The qretools command: check and export a workspace and its instruments, for CI and the terminal",
	"bin": {
		"qretools": "./bin/qretools.ts"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check": "tsc --noEmit && vitest run"
	},
	"dependencies": {
		"@qretools/core": "workspace:*",
		"@qretools/qsf": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
