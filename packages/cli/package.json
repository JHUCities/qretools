{
	"name": "qretools",
	"version": "2.0.0-alpha.3",
	"type": "module",
	"description": "The qretools command: check and export a workspace and its instruments, for CI and the terminal",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JHUCities/qretools.git",
		"directory": "packages/cli"
	},
	"homepage": "https://qretools.com",
	"bin": {
		"qretools": "./dist/qretools.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.contract.json",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.contract.json && vitest run",
		"bundle": "rolldown -c && cp ../../LICENSE LICENSE",
		"prepack": "pnpm run bundle"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@qretools/core": "workspace:*",
		"@qretools/qsf": "workspace:*",
		"@qretools/shell": "workspace:*",
		"@types/node": "^26.6.4",
		"rolldown": "1.2.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
