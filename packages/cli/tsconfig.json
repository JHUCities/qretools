{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023"],
		// Node runs the command as written, stripping types: only syntax it can strip.
		"erasableSyntaxOnly": true,
		"types": ["vite/client", "node"]
	},
	"include": ["src", "bin"],
	// It reads through the app's GitHub adapter too, whose types are the browser's.
	"exclude": ["src/contract.test.ts"]
}
