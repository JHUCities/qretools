{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// No DOM: the core is pure, so a browser API used here is a compile error.
		"lib": ["ES2023"],
		// Node runs the core as written, stripping types: only syntax it can strip.
		"erasableSyntaxOnly": true
	},
	"include": ["src"],
	// Tests that read fixtures from disk, or parse HTML, have their own configs.
	"exclude": ["src/node", "src/dom"]
}
