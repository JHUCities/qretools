{
	"name": "@qretools/bank",
	"version": "2.0.0-alpha.0",
	"private": true,
	"type": "module",
	"description": "The question bank editor: questions as YAML, elaborated to DDI-Lifecycle 4.0",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
