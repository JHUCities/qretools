{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": false
	},
	"files": {
		"includes": [
			"apps/*/src/**",
			"apps/*/*.ts",
			"apps/*/*.json",
			"packages/*/src/**",
			"packages/*/*.ts",
			"packages/*/*.json",
			"worker/src/**",
			"*.ts",
			"*.json",
			"!**/node_modules",
			"!**/dist"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
