{
	"name": "qretools",
	"version": "2.0.0-alpha.0",
	"private": true,
	"type": "module",
	"description": "Next-generation survey question authoring to DDI-Lifecycle 4.0",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "pnpm typecheck && pnpm lint && pnpm test",
		"check:worker": "pnpm --dir worker check",
		"dev:verify": "vite --mode verify --port 5299 --strictPort"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.5",
		"@codemirror/view": "^6.43.12",
		"@lezer/highlight": "1.2.3",
		"@octokit/core": "^7.0.8",
		"@octokit/plugin-retry": "^8.1.1",
		"@octokit/plugin-throttling": "^11.0.5",
		"@octokit/request-error": "^7.1.2",
		"@primer/octicons": "^19.38.0",
		"@primer/octicons-react": "^19.38.0",
		"@primer/primitives": "^11.10.0",
		"@primer/react": "^38.40.0",
		"ajv": "^8.20.0",
		"codemirror": "^6.0.2",
		"codemirror-json-schema": "^0.8.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^30.1.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
