{
	"name": "qretools",
	"private": true,
	"type": "module",
	"description": "Next-generation survey question authoring to DDI-Lifecycle 4.0",
	"scripts": {
		"dev": "pnpm --filter @qretools/bank dev",
		"dev:verify": "pnpm --filter @qretools/bank dev:verify",
		"dev:instrument": "pnpm --filter @qretools/instrument dev",
		"dev:instrument:verify": "pnpm --filter @qretools/instrument dev:verify",
		"build": "pnpm --filter @qretools/bank build",
		"preview": "pnpm --filter @qretools/bank preview",
		"test": "pnpm -r run test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "biome check . && pnpm -r run check",
		"check:worker": "pnpm --dir worker --ignore-workspace check",
		"qretools": "node packages/core/bin/qretools.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14"
	}
}
