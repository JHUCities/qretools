# Development build configuration (committed: nothing here is secret).
# The token-paste fallback is on in development, off in production builds.
VITE_FLAG_TOKEN_PASTE=true
# Fill in after creating the GitHub App and deploying the Worker (see AGENTS.md, step 10).
VITE_GITHUB_CLIENT_ID=
VITE_AUTH_URL=
VITE_GITHUB_APP_SLUG=
