{
	"name": "qretools-auth-worker",
	"private": true,
	"type": "module",
	"description": "Token exchange for qretools' GitHub App sign-in: the one narrow exception to 'no server'.",
	"scripts": {
		"dev": "wrangler dev --port 8787",
		"deploy": "wrangler deploy",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "tsc --noEmit && vitest run"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261024.1",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"wrangler": "4.140.0"
	}
}
